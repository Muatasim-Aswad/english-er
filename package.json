    "test:all": "vp run test",
    "typecheck:all": "vp run typecheck"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@11.24.0"
