#!/usr/bin/env python3
"""Secret-scan the requested Git range and a tracked-files-only source export."""

import os
import subprocess
import tarfile
import tempfile
from pathlib import Path

root = Path(__file__).resolve().parents[1]
subprocess.run(
    [
        "gitleaks",
        "git",
        "--redact",
        "--no-banner",
        "--log-opts",
        os.environ.get("GITLEAKS_RANGE", "HEAD"),
        str(root),
    ],
    check=True,
)
with tempfile.TemporaryDirectory(prefix="english-er-source-scan-") as temporary:
    workspace = Path(temporary)
    archive = workspace / "source.tar"
    source = workspace / "source"
    source.mkdir()
    subprocess.run(["git", "archive", "HEAD", "--output", str(archive)], cwd=root, check=True)
    with tarfile.open(archive) as tracked:
        tracked.extractall(source, filter="data")
    subprocess.run(["gitleaks", "dir", "--redact", "--no-banner", str(source)], check=True)
web = root / "apps/web/dist"
if web.is_dir():
    subprocess.run(["gitleaks", "dir", "--redact", "--no-banner", str(web)], check=True)
