#!/usr/bin/env bash
set -u

if [[ $# -ne 1 ]]; then
  printf 'usage: %s <mise-task>\n' "$0" >&2
  exit 64
fi

task_name=$1
log_file=$(mktemp)
trap 'rm -f "$log_file"' EXIT

if mise run "$task_name" >"$log_file" 2>&1; then
  printf 'PASS %s\n' "$task_name"
  exit 0
else
  status=$?
fi

printf 'FAIL %s (exit %d); final 120 lines:\n' "$task_name" "$status" >&2
tail -n 120 "$log_file" >&2
exit "$status"
